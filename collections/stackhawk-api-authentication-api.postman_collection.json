{
  "item": [
    {
      "id": "664eeb6e-d27e-41c6-ae84-1ffa70040c9c",
      "name": "Api Authentication",
      "description": {
        "content": "Token management and login",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "346ba7c9-887c-48fb-b0b7-22bfa668a2e3",
          "name": "Login With API Key",
          "request": {
            "name": "Login With API Key",
            "description": {
              "content": "Authenticate using an API key to obtain a JWT access token. The API key is passed in the X-ApiKey header. Tokens expire after 30 minutes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) StackHawk API key from Settings > API Keys",
                "key": "X-ApiKey",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "d09d7bdb-162d-47fb-883d-a904f54afb7c",
              "name": "JWT token response",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) StackHawk API key from Settings > API Keys",
                    "key": "X-ApiKey",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"string\",\n  \"expiresAt\": \"2017-06-16T17:34:13.472Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "id": "0c77b1a5-638b-4068-990f-59f921dabb63",
          "name": "Refresh Token",
          "request": {
            "name": "Refresh Token",
            "description": {
              "content": "Refresh an existing JWT access token before it expires.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "auth",
                "refresh-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "17647d0c-d15d-4eb4-a29a-933e90299990",
              "name": "Refreshed JWT token",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "refresh-token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"string\",\n  \"expiresAt\": \"2017-06-16T17:34:13.472Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api.stackhawk.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "info": {
    "_postman_id": "88ed073c-c5a7-4a40-85f8-56d3ee09daa5",
    "name": "StackHawk Api Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The StackHawk Public API provides programmatic access to the StackHawk application and API security testing platform. Manage applications, environments, scan configurations, scan results, findings, repositories, teams, policies, and security reports. Authentication requires obtaining a JWT token via the /api/v1/auth/login endpoint using an API key from the StackHawk platform settings.\n\nContact Support:\n Email: support@stackhawk.com",
      "type": "text/plain"
    }
  }
}