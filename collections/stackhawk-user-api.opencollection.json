{
  "opencollection": "1.0.0",
  "info": {
    "name": "StackHawk Api Authentication User API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Current User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stackhawk.com/api/v1/user"
          },
          "docs": "Retrieve information about the currently authenticated user."
        },
        {
          "info": {
            "name": "Update User Profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.stackhawk.com/api/v1/user",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update profile information for the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}