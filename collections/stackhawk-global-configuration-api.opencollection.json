{
  "opencollection": "1.0.0",
  "info": {
    "name": "StackHawk Api Authentication Global Configuration API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Global Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Global Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stackhawk.com/api/v1/global-configuration/:configName",
            "params": [
              {
                "name": "configName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an organization-level global configuration by name."
        }
      ]
    }
  ],
  "bundled": true
}